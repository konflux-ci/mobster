FROM registry.access.redhat.com/ubi10/ubi:latest

# This needs to line up with the version we use for Atlas.
# Verify via the following URL before changing:
# https://gitlab.cee.redhat.com/service/app-interface/-/blob/master/data/services/atlas/atlas-release/saas/atlas-v2.yml?ref_type=heads
ARG TRUSTD_VERSION=0.4.17

USER root

RUN useradd --uid 1000 tpa && \
    dnf install -y tar gzip && \
    dnf clean all

USER tpa

WORKDIR /app

RUN curl -L https://github.com/guacsec/trustify/releases/download/v${TRUSTD_VERSION}/trustd-pm-${TRUSTD_VERSION}-x86_64-unknown-linux-gnu.tar.gz \
    -o trustd-pm.tar.gz && \
    tar -xzf trustd-pm.tar.gz && \
    rm trustd-pm.tar.gz

WORKDIR /app/trustd-pm-${TRUSTD_VERSION}-x86_64-unknown-linux-gnu/

ENV AUTH_DISABLED=true
ENV HTTP_SERVER_BIND_ADDR=::

CMD ["./trustd-pm"]
